# ============================================================
# Meeting-Ops-Agent Environment Configuration
# Copy this file to .env and fill in your values
# ============================================================

# --- LLM Provider ---
# OpenAI (default)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o

# Alternatively, use Azure OpenAI
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_ENDPOINT=
# AZURE_OPENAI_DEPLOYMENT=

# --- Database ---
DATABASE_URL=sqlite:///./meeting_ops.db
# For PostgreSQL: postgresql://user:password@localhost:5432/meeting_ops

# --- Redis (for task queue and caching) ---
REDIS_URL=redis://localhost:6379/0

# --- GitHub Connector ---
GITHUB_TOKEN=your_github_personal_access_token
GITHUB_DEFAULT_REPO=owner/repo-name

# --- Jira Connector ---
JIRA_SERVER_URL=https://your-domain.atlassian.net
JIRA_USER_EMAIL=your@email.com
JIRA_API_TOKEN=your_jira_api_token
JIRA_DEFAULT_PROJECT_KEY=PROJ

# --- Slack Connector ---
SLACK_BOT_TOKEN=xoxb-your-slack-bot-token
SLACK_SIGNING_SECRET=your_slack_signing_secret
SLACK_DEFAULT_CHANNEL=#general

# --- Notion Connector ---
NOTION_API_KEY=secret_your_notion_api_key
NOTION_DEFAULT_DATABASE_ID=your_notion_database_id

# --- Application Settings ---
APP_ENV=development
APP_SECRET_KEY=change_this_to_a_random_secret_key
APP_HOST=0.0.0.0
APP_PORT=8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- File Upload ---
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=100

# --- Follow-up Scheduler ---
FOLLOWUP_CHECK_INTERVAL_HOURS=24
RISK_CHECK_INTERVAL_HOURS=48

# --- Frontend (for Docker) ---
REACT_APP_API_URL=http://localhost:8000
